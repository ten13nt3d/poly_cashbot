# Database Configuration
DATABASE_URL=postgresql+asyncpg://cashbot_user:dev_password@localhost:5432/poly_cashbot

# Redis Configuration
REDIS_URL=redis://localhost:6379

# Polymarket API (REQUIRED)
# Get your API keys from: https://polymarket.com/settings/api
POLYMARKET_API_KEY=your_polymarket_api_key_here
POLYMARKET_SECRET_KEY=your_polymarket_secret_key_here
POLYMARKET_CHAIN_ID=137
POLYMARKET_HOST=https://clob.polymarket.com

# Price Feed APIs (Optional but recommended)
# CoinGecko: Free tier available at https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# CoinCap: Free tier at https://coincap.io/
COINCAP_API_KEY=

# News APIs (Optional, for Phase 2)
# NewsAPI: Free tier at https://newsapi.org/
NEWSAPI_KEY=

# GNews: Free tier at https://gnews.io/
GNEWS_API_KEY=

# Risk Management (REQUIRED)
# Starting capital in USDC (minimum $10, tested up to $1000+)
STARTING_CAPITAL=100.00

# Risk per trade as decimal (0.02 = 2%)
PER_TRADE_RISK_PCT=0.02

# Daily loss limit as decimal (0.10 = 10%)
DAILY_LOSS_LIMIT_PCT=0.10

# Maximum concurrent open positions
MAX_CONCURRENT_POSITIONS=5

# Minimum position size in USDC
MIN_POSITION_SIZE=5.00

# Trading Strategy Configuration
# Minimum confidence to execute trade (0.80 = 80%)
MIN_CONFIDENCE_THRESHOLD=0.80

# Minimum sentiment magnitude to trade (40 = ±40 out of ±100)
MIN_SENTIMENT_MAGNITUDE=40

# Minimum market liquidity in USDC
MIN_MARKET_LIQUIDITY=10000

# Priority crypto asset (XRP, BTC, or ETH)
PRIORITY_CRYPTO_ASSET=XRP

# Telegram Alerts (REQUIRED)
# Create bot via @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Paper Trading Mode
# Set to true for testing without real orders
PAPER_TRADING=false
